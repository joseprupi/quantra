*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/
.hatch/

# Virtual environments
.venv/
venv/
env/
.python-version.local

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
