# Quantra self-hosted — RELEASE env (image-pinned compose).
#
# Used by docker-compose.release.yml — the image-pinned variant of the
# repo-root compose file, running the prebuilt platform images published to
# GHCR on every release tag (pull-and-run via ./install.sh, or offline via
# ./install-offline.sh). Copy next to docker-compose.release.yml and adjust
# as needed:
#
#   cp .env.example .env
#
# Every knob the release compose reads is documented below.

# ---------------------------------------------------------------------------
# Registry / namespace + version pinning
# ---------------------------------------------------------------------------
# REGISTRY is a SINGLE variable holding registry host + namespace for all
# three backend images (quantra-orchestrator, quantra-market-data,
# quantra-md-ingester) AND the portal (quantra-portal). Change it to point at
# a different registry/namespace in one place.
REGISTRY=ghcr.io/joseprupi

# QUANTRA_VERSION is the version tag the backend + portal image refs resolve
# to. In a downloaded release bundle this is pre-pinned to that release's
# version; keep it matched to a published release tag (see the GitHub
# Releases page) unless you built + tagged images locally.
QUANTRA_VERSION=0.4.0

# ---------------------------------------------------------------------------
# Architecture: images are amd64-only (Apple Silicon runs via Rosetta)
# ---------------------------------------------------------------------------
# The engine image (and locally built images saved into an offline tarball on
# an amd64 machine) are linux/amd64 ONLY. On an arm64 host (Apple Silicon),
# pin the platform so Docker runs them under Rosetta/qemu emulation instead
# of failing with "no matching manifest":
#
#   export DOCKER_DEFAULT_PLATFORM=linux/amd64
#
# (install-offline.sh exports this automatically; the compose file also pins
# `platform: linux/amd64` per service as a backstop.)

# ---------------------------------------------------------------------------
# Pricing engine (separate open-source repo — publicly pullable today)
# ---------------------------------------------------------------------------
# The DEFAULT engine image is the public GHCR image of the quantraserver
# project (pinned to 0.2.0). It ships its OWN entrypoint (see
# QUANTRA_ENGINE_COMMAND below).
QUANTRA_ENGINE_IMAGE=ghcr.io/joseprupi/quantra-server:0.2.0

# Leave EMPTY (the default) to run the engine image's OWN entrypoint — this is
# what the PUBLIC GHCR image above needs (quantra start Envoy cluster + JSON
# server, gRPC on :50051). The compose default is colon-less so an EMPTY value
# wins (command: []). Only set a value if you REPOINT QUANTRA_ENGINE_IMAGE at a
# locally built `quantraserver:local` engine, whose sync_server binary must be
# launched explicitly: QUANTRA_ENGINE_COMMAND=/src/build/server/sync_server 50051
# The public GHCR image has NO such path — setting it there crashes the engine.
QUANTRA_ENGINE_COMMAND=

# ---------------------------------------------------------------------------
# Fallback valuation date
# ---------------------------------------------------------------------------
# REAL-DATA-ONLY: the portal defaults the pricing As-Of to the latest real
# ingested business day (from /v1/market-data/latest-date), and roll-curve-dates
# advances the seeded real curves' reference_date to match. This value is only a
# fallback used before the first real ingest lands. Leave as-is unless you know
# why.
DEFAULT_AS_OF=2025-01-15

# ---------------------------------------------------------------------------
# Real market data: FRED API key (OPTIONAL)
# ---------------------------------------------------------------------------
# The stack ingests REAL, daily-refreshed public market data. Most feeds need
# NO key and are always on:
#
#   * BoE SONIA OIS (the GBP flagship curve), BoE gilt  — keyless
#   * US Treasury official curve                        — keyless
#   * ECB (EUR FX reference rates + inflation)          — keyless
#
# FRED is the ONE exception: it needs a free API key. With a key you also get
# ~31 US series (UST DGS yields, SOFR/EFFR, CPI/PCE, inflation breakevens,
# credit OAS, VIX/MOVE). Get one free (email signup, instant) at:
#
#   https://fredaccount.stlouisfed.org/apikeys
#
# LEAVE IT EMPTY and nothing breaks: the FRED boot ingest and the 22:00 UTC
# FRED cron tick fail-and-skip ("FRED_API_KEY is required"), the app still
# boots, and every other feed above keeps working — you just have no FRED
# series. Paste your key after the `=` to enable them.
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Host ports (change if something already listens on these on your machine)
# ---------------------------------------------------------------------------
PORTAL_HOST_PORT=5173
ORCHESTRATOR_HOST_PORT=8080
MD_SERVICE_HOST_PORT=8082
QUANTRA_ENGINE_HOST_PORT=50051
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Container / network names (override to run side-by-side with another stack)
# ---------------------------------------------------------------------------
POSTGRES_CONTAINER_NAME=quantra-release-postgres
ENGINE_CONTAINER_NAME=quantra-release-engine
MD_CONTAINER_NAME=quantra-release-market-data
PORTAL_CONTAINER_NAME=quantra-release-portal
QUANTRA_NET_NAME=quantra-release-net

LOG_LEVEL=INFO
