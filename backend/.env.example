# Canonical environment for Quantra backend services.
#
# Copy to `.env` (gitignored) and fill in real secrets locally. Every
# variable here is read by `quantra_common.settings.Settings` (or the
# per-service settings layered on top of it). The defaults below are safe to
# commit and match what `docker compose up postgres` boots.

# -- Environment -------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# -- Postgres DSNs -----------------------------------------------------------
# One Postgres instance, two schemas (app.*, md.*), distinct roles per schema
# with their own pool sizes.
#
# Role provisioning lives in `migrations/alembic/versions/{app,md}/0001_init.py`;
# usernames + passwords below match what those migrations create. Dev
# passwords intentionally equal the role name — these are local-only.
#
# Override POSTGRES_HOST_PORT below if your machine already has another
# Postgres on 5432; remember to update the four DSN ports to match.
POSTGRES_HOST_PORT=5432
POSTGRES_DSN_APP_RW=postgresql+asyncpg://app_rw:app_rw@localhost:5432/quantra
POSTGRES_DSN_APP_RO=postgresql+asyncpg://app_ro:app_ro@localhost:5432/quantra
POSTGRES_DSN_MD_RW=postgresql+asyncpg://md_rw:md_rw@localhost:5432/quantra
POSTGRES_DSN_MD_RO=postgresql+asyncpg://md_ro:md_ro@localhost:5432/quantra

# Superuser DSN used only by Alembic (and the very first
# `docker compose up`-then-`alembic upgrade head` bootstrap). Runtime
# services NEVER read this.
POSTGRES_DSN_ADMIN=postgresql+asyncpg://quantra:quantra@localhost:5432/quantra

# -- Connection pool sizing (per role) ---------------------------------------
# Each runtime role gets its own steady pool + burst overflow so a runaway
# md_rw ingester cannot starve app_rw user requests. The defaults below are
# sized for one process per service against Postgres' default
# max_connections=100; see the README "Connection pool math" note before
# raising any of them.
PG_POOL_SIZE_APP_RW=20
PG_POOL_MAX_OVERFLOW_APP_RW=10
PG_POOL_SIZE_APP_RO=10
PG_POOL_MAX_OVERFLOW_APP_RO=5
PG_POOL_SIZE_MD_RW=4
PG_POOL_MAX_OVERFLOW_MD_RW=4
PG_POOL_SIZE_MD_RO=15
PG_POOL_MAX_OVERFLOW_MD_RO=10
# Seconds a checkout waits for a free connection before raising
# TimeoutError. Short on purpose so saturation surfaces fast.
PG_POOL_TIMEOUT_S=10.0
# Connections reserved for the admin role + replication + operator psql.
# Subtracted from max_connections before per-role caps are sized.
PG_POOL_ADMIN_HEADROOM=10

# -- Auth --------------------------------------------------------------------
# DEV ONLY: set to true to skip all credential checks and resolve every
# request to a single implicit `dev-user` principal — what the self-hosted
# compose stack runs with (it sets the variable in-container). Refused at
# boot when ENV=prod.
#
# ⚠ Keep it FALSE in the `.env` of a checkout you run `uv run pytest` in:
# the test suite reads this file, and a bypass-enabled environment makes
# the auth tests fail.
DEV_AUTH_BYPASS=false

# Firebase project ID used to validate ID tokens (DORMANT hosted-auth path —
# only relevant if you deploy with real multi-user auth instead of the
# dev bypass above). Leave blank for self-hosted / dev / CI.
FIREBASE_PROJECT_ID=

# -- Orchestrator ------------------------------------------------------------
# Port `python -m quantra_orchestrator` binds. The compose stacks publish the
# orchestrator on host port 8080 as well.
ORCHESTRATOR_PORT=8080

# -- Internal services -------------------------------------------------------
MD_SERVICE_URL=http://localhost:8082
MD_SERVICE_TIMEOUT_S=10.0

# Market data read service (services/market_data). Listen port and the
# default snapshot reported by /status / /market/latest.
MD_SERVICE_PORT=8082
DEFAULT_SNAPSHOT_NAME=PUBLIC_USD_EOD

# -- Pricing engine (gRPC) ---------------------------------------------------
# Where the orchestrator dials the quantraserver gRPC engine. LEAVE UNSET and
# the orchestrator falls back to a built-in STUB engine client: the API boots
# and validates requests, but every pricing call fails with
# `engine_unavailable` — fine for pure-API development, useless for pricing.
# Set it to a real engine to price, e.g. the `live-engine` compose profile:
#
#   docker compose --profile live-engine up -d quantra-engine
#
ENGINE_GRPC_TARGET=localhost:50051
ENGINE_GRPC_TIMEOUT_S=30.0

# -- Market-data ingester (optional) ------------------------------------------
# The FRED connector is the ONLY feed needing an API key (free:
# https://fredaccount.stlouisfed.org/apikeys). Leave empty and the FRED
# ingest fails-and-skips; every other public feed (BoE, US Treasury, ECB)
# is keyless.
FRED_API_KEY=

# -- Portal ------------------------------------------------------------------
# Fallback pricing As-Of date the portal prefills before the first real
# market-data ingest lands (afterwards it follows /v1/market-data/latest-date).
# Read by the compose stacks; harmless for host-run services.
DEFAULT_AS_OF=2025-01-15

# -- Request plumbing --------------------------------------------------------
REQUEST_ID_HEADER=X-Request-Id
