# Orchestrator URL. Points to the Quantra orchestrator API. Defaults to
# http://localhost:8080 when unset (suitable for local dev). Override for
# other deployments.
# VITE_ORCHESTRATOR_URL=http://localhost:8080

# Dev-auth bypass: "true" runs the portal as a single implicit dev user with
# no login. The orchestrator must run with its matching bypass flag.
# VITE_DEV_AUTH_BYPASS=true

# Market-data catalog service URL (Quote Book / Time Series Lab). Defaults to
# http://localhost:8082 in dev, or the same-origin /_md prefix in a
# production build.
# VITE_MARKET_DATA_API_URL=http://localhost:8082

# Optional ISO YYYY-MM-DD initial As-Of date for the pricing forms.
# VITE_DEFAULT_AS_OF=

# Firebase configuration — only needed for a hosted build with real login.
# Unused in self-hosted / dev-bypass mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Firebase Analytics measurement id (passed through to the Firebase
# app config; only meaningful for a hosted build).
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional: "true" connects to local Firebase emulators (auth :9099,
# firestore :8081) in dev mode.
# VITE_USE_EMULATORS=true
