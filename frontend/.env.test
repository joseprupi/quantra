# Hermetic env for `vitest` (Vite mode=test loads this file; it is tracked so
# the suite passes on a fresh clone with no local secrets).
#
# The dev auth bypass must default OFF in tests so the suite exercises the
# real Firebase Bearer-token path; bypass-specific tests opt in via
# vi.stubEnv. With bypass off, firebase.ts requires apiKey/authDomain/
# projectId at import time — provide inert dummies (no test ever performs a
# real Firebase network call).
VITE_DEV_AUTH_BYPASS=false
VITE_FIREBASE_API_KEY=test-only-not-a-real-key
VITE_FIREBASE_AUTH_DOMAIN=test.invalid
VITE_FIREBASE_PROJECT_ID=quantra-test
